{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "outDir": "out/tsconfig.node.tsbuildinfo"
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*"]
}
